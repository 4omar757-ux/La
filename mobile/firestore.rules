rules_version = '2';

// قواعد أولية بسيطة لتشغيل غرف اللعب الجماعي بدون تسجيل دخول (MVP).
// أي شخص يعرف رمز الغرفة يقدر يقرأ/يكتب بياناتها. هذا كافٍ للعب بين أصدقاء
// بغرفة مؤقتة، لكنه غير آمن لإطلاق عام واسع — أضف Firebase Authentication
// (حتى لو Anonymous) قبل أي إطلاق جماهيري، وقيّد الكتابة بمالك المستند.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(
        ['cityId', 'status', 'durationMinutes', 'hostPlayerId']
      );
      allow update: if resource.data.status in ['waiting', 'playing'];

      match /players/{playerId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll(
          ['name', 'gold', 'population', 'happiness', 'score']
        );
        allow update, delete: if true;
      }
    }
  }
}
